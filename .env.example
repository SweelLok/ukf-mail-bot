# Скопируй этот файл в .env и заполни своими значениями:
#   cp .env.example .env

TELEGRAM_BOT_TOKEN=
MAIL_USER=
MAIL_PASSWORD=
TELEGRAM_CHAT_ID=
# Доступ к боту только для твоего Telegram user_id.
# Узнать свой ID: напиши боту @userinfobot в Telegram — пришлёт число.
# Остальные пользователи бот молча игнорирует.
TELEGRAM_ADMIN_ID=
